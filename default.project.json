{
  "name": "DunkSimulator",
  "globIgnorePaths": ["**/README.md"],
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$className": "Folder",
        "$path": "src/shared",
        "$ignoreUnknownInstances": false
      },
      "Leaderboards": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Contest": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Remotes": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "RequestDunk": {
          "$className": "RemoteEvent"
        },
        "DunkResult": {
          "$className": "RemoteEvent"
        },
        "DunkPresentation": {
          "$className": "RemoteEvent"
        },
        "DunkTrick": {
          "$className": "RemoteEvent"
        },
        "SlamTiming": {
          "$className": "RemoteEvent"
        },
        "RebirthRequest": {
          "$className": "RemoteEvent"
        },
        "RebirthState": {
          "$className": "RemoteEvent"
        },
        "DailyRequest": {
          "$className": "RemoteEvent"
        },
        "DailyState": {
          "$className": "RemoteEvent"
        },
        "ContestScore": {
          "$className": "RemoteEvent"
        },
        "ContestResult": {
          "$className": "RemoteEvent"
        },
        "LockerRequest": {
          "$className": "RemoteEvent"
        },
        "LockerState": {
          "$className": "RemoteEvent"
        },
        "SocialNotice": {
          "$className": "RemoteEvent"
        },
        "AutoTrainRequest": {
          "$className": "RemoteEvent"
        },
        "SettingsRequest": {
          "$className": "RemoteEvent"
        },
        "GroupRequest": {
          "$className": "RemoteEvent"
        },
        "CodeRequest": {
          "$className": "RemoteEvent"
        },
        "AbilityRequest": {
          "$className": "RemoteEvent"
        },
        "TrainingPulse": {
          "$className": "RemoteEvent"
        },
        "PickupEvent": {
          "$className": "RemoteEvent"
        },
        "CrewRequest": {
          "$className": "RemoteEvent"
        },
        "SeasonRequest": {
          "$className": "RemoteEvent"
        },
        "PayoutOffer": {
          "$className": "RemoteEvent"
        },
        "DunkAnimationStatus": {
          "$className": "RemoteEvent"
        },
        "EquipDunkStyle": {
          "$className": "RemoteEvent"
        },
        "CourtRequest": {
          "$className": "RemoteEvent"
        },
        "CourtState": {
          "$className": "RemoteEvent"
        },
        "TrainingUpgradeRequest": {
          "$className": "RemoteEvent"
        },
        "TrainingUpgradeState": {
          "$className": "RemoteEvent"
        },
        "TrainingCapNotice": {
          "$className": "RemoteEvent"
        },
        "ChallengeRequest": {
          "$className": "RemoteEvent"
        },
        "ChallengeState": {
          "$className": "RemoteEvent"
        },
        "GiftRequest": {
          "$className": "RemoteEvent"
        },
        "GiftState": {
          "$className": "RemoteEvent"
        },
        "GoalState": {
          "$className": "RemoteEvent"
        },
        "AfkPractice": {
          "$className": "RemoteEvent"
        },
        "NotificationPrompt": {
          "$className": "RemoteEvent"
        }
      }
    }
  }
}
