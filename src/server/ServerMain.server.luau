local PlayerService = require(script.Parent.services.PlayerService)
local TrainingService = require(script.Parent.services.TrainingService)
local BasketballService = require(script.Parent.services.BasketballService)
local DunkService = require(script.Parent.services.DunkService)
local DunkAnimationController = require(script.Parent.services.DunkAnimationController)
local DunkStyleService = require(script.Parent.services.DunkStyleService)
local UpgradeService = require(script.Parent.services.UpgradeService)
local CourtService = require(script.Parent.services.CourtService)
local CourtTravel = require(script.Parent.services.CourtTravel)
local ChallengeService = require(script.Parent.services.ChallengeService)
local SlamTiming = require(script.Parent.services.SlamTiming)
local RebirthService = require(script.Parent.services.RebirthService)
local DailyService = require(script.Parent.services.DailyService)
local LeaderboardService = require(script.Parent.services.LeaderboardService)
local ContestService = require(script.Parent.services.ContestService)
local LockerService = require(script.Parent.services.LockerService)
local MonetizationService = require(script.Parent.services.MonetizationService)
local ProgressionConfig = require(game:GetService("ReplicatedStorage").Shared.Config.ProgressionConfig)

workspace.Gravity = ProgressionConfig.Jump.Gravity

CourtService.Init()
ChallengeService.Init()
DunkAnimationController.Init()
PlayerService.Init(CourtTravel.PlacePlayer, function(player)
	ChallengeService.OnPlayerReady(player)
	local ok, problem = pcall(DailyService.OnPlayerReady, player)
	if not ok then warn("[ServerMain] Daily setup failed: " .. tostring(problem)) end
	local dressed, lockerProblem = pcall(LockerService.OnPlayerReady, player)
	if not dressed then warn("[ServerMain] Locker setup failed: " .. tostring(lockerProblem)) end
	task.spawn(MonetizationService.OnPlayerReady, player)
end)
TrainingService.Init()
BasketballService.Init()
DunkService.Init()
SlamTiming.Init()
RebirthService.Init()
DailyService.Init()
LeaderboardService.Init()
ContestService.Init()
LockerService.Init()
MonetizationService.Init()
DunkStyleService.Init()
UpgradeService.Init()

print("[DunkSimulator] Gameplay initialized; progression unlocks after safe player-data loading.")
